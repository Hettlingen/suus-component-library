{
  "name": "suus-component-library",
  "version": "0.1.33",
  "type": "module",
  "main": "./dist/suus-component-library.umd.cjs",
  "module": "./dist/suus-component-library.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/suus-component-library.js",
      "require": "./dist/suus-component-library.umd.cjs"
    },
    "./styles.css": "./dist/suus-component-library.css"
  },
  "scripts": {
    "build-component-library": "tsc -b && vite build",
    "publish-component-library": "npm version patch && npm publish",
    "build-component-library-for-local-testing": "npm pack",
    "build-storybook": "storybook build",
    "build-storybook:github": "STORYBOOK_BASE=/suus-component-library/ storybook build",
    "build-storybook:local": "STORYBOOK_BASE=/ storybook build",
    "run-storybook-static": "npx http-server storybook-static -p 63342",
    "run-storybook-local": "storybook dev -p 6006"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/react-vite": "^10.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.5.6",
    "globals": "^17.6.0",
    "react": "latest",
    "react-dom": "latest",
    "storybook": "^10.5.6",
    "typescript": "latest",
    "typescript-eslint": "^8.59.2",
    "vite": "latest",
    "vite-plugin-dts": "latest"
  },
  "dependencies": {
    "msw": "^2.14.6",
    "suus-design-tokens": "^1.0.27"
  }
}
